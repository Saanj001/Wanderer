# AI features (use either one; Gemini wins if both are set)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=

# Train reminders (web push). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: GIF search in chat (free key at developers.giphy.com)
GIPHY_API_KEY=

# REQUIRED for accounts, reminders and notifications (server only — never expose). Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optional TURN relay for video calls on strict mobile networks
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=
NEXT_PUBLIC_TURN_PASS=

# Group video calls for 5+ people (LiveKit Cloud: cloud.livekit.io → project → Settings → Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
